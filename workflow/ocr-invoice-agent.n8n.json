      "name": "AI Agent - Text",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1740,
        640
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Extract the invoice fields from the following invoice text. Return JSON only.\n\n---\n{{ $json.text }}\n---",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an invoice-extraction assistant. You receive the raw text extracted from an invoice PDF. Extract the fields defined in the output schema exactly.\n\nRules:\n- Dates in ISO 8601 (YYYY-MM-DD). If only month/year is visible, use the 1st.\n- invoice_datetime_pretty: human-readable datetime copied from the receipt, e.g. 'Dec 19, 2025 (Fri) 05:29 PM'. Null if not visible.\n- Amounts are numbers only (no currency symbols, no thousands separators).\n- Currency is the ISO 4217 code. Infer from symbols or context (e.g. 'Senior Discount' and 'PWD Discount' imply PHP).\n- payment_method: e.g. 'Credit (Master Card)', 'Cash', 'Debit'. Null if not visible.\n- discounts: array of {label, amount as POSITIVE number} for each discount/adjustment line (EVAT, Senior Discount, PWD Discount, etc.). [] if none.\n- pax, seniors_count, pwd_count: integers from receipt. Null if not visible.\n- cashier: cashier name/id. Null if not visible.\n- If a field is not visible or unclear, return null. Do NOT invent data.\n- line_items: one object per row. Return [] if none visible.\n- Ignore anything not part of the invoice.",
          "passthroughBinaryImages": false
        }
      }
    },
