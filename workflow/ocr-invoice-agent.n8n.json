    {
      "id": "14ec3379-7d31-4a05-8f52-985c652a44be",
      "name": "Gemini - Analyze Image",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        1540,
        140
      ],
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "gemini-2.5-flash"
        },
        "text": "Extract invoice fields from this image. Return ONLY valid JSON matching this schema:\n{\n  \"vendor_name\": string|null,\n  \"invoice_number\": string|null,\n  \"invoice_date\": \"YYYY-MM-DD\"|null,\n  \"invoice_datetime_pretty\": string|null,\n  \"due_date\": \"YYYY-MM-DD\"|null,\n  \"subtotal\": number|null,\n  \"tax\": number|null,\n  \"total\": number|null,\n  \"currency\": \"ISO 4217 code\"|null,\n  \"payment_method\": string|null,\n  \"discounts\": [{\"label\": string, \"amount\": number}],\n  \"pax\": number|null,\n  \"seniors_count\": number|null,\n  \"pwd_count\": number|null,\n  \"cashier\": string|null,\n  \"line_items\": [{\"description\": string, \"quantity\": number, \"unit_price\": number, \"line_total\": number}]\n}\n\nRules:\n- Dates in ISO 8601 (YYYY-MM-DD). If only month/year is visible, use the 1st.\n- invoice_datetime_pretty: human-readable datetime copied from the receipt, e.g. 'Dec 19, 2025 (Fri) 05:29 PM'. Null if not visible.\n- Amounts are numbers only (no currency symbols, no thousands separators).\n- Currency is the ISO 4217 code. Infer from symbols (\u20b1 = PHP, \u00a5 = JPY, $ = USD, \u20ac = EUR) or context (e.g. 'Senior Discount' and 'PWD Discount' imply PHP).\n- payment_method: e.g. 'Credit (Master Card)', 'Cash', 'Debit'. Null if not visible.\n- discounts: array of {label, amount as POSITIVE number} for each discount/adjustment line (EVAT, Senior Discount, PWD Discount, etc.). [] if none.\n- pax, seniors_count, pwd_count: integers from receipt (look for PAX, #SENIORS, #PWD labels). Null if not visible.\n- cashier: cashier name/id from receipt. Null if not visible.\n- If a field is not visible or unclear, return null. Do NOT invent data.\n- line_items: one object per row. Return [] if none visible.\n- Output ONLY the JSON object, no markdown fences, no commentary.",
        "inputType": "binary",
        "binaryPropertyName": "data",
        "simplify": true,
        "options": {
          "maxOutputTokens": 8000
        }
      }
    },
    {
      "id": "d9ca6c01-afe7-473a-afa6-505bf1cd4d9e",
      "name": "AI Agent - Vision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        140
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\n\nconst raw =\n  item?.content?.parts?.[0]?.text ??\n  item?.parts?.[0]?.text ??\n  item?.response?.parts?.[0]?.text ??\n  item?.candidates?.[0]?.content?.parts?.[0]?.text ??\n  (typeof item?.content === 'string' ? item.content : null) ??\n  (typeof item?.text === 'string' ? item.text : null) ??\n  (typeof item?.response === 'string' ? item.response : null);\n\nif (typeof raw !== 'string') {\n  throw new Error('Could not find text in Gemini response. Top-level keys: ' + Object.keys(item || {}).join(', '));\n}\n\nlet cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```\\s*$/, '')\n  .trim();\n\nconst repair = (s) => s\n  .replace(/,(\\s*[}\\]])/g, '$1')\n  .replace(/[\\u201C\\u201D]/g, '\"')\n  .replace(/[\\u2018\\u2019]/g, \"'\");\n\ntry { return { output: JSON.parse(cleaned) }; } catch (_) {}\ntry { return { output: JSON.parse(repair(cleaned)), _repaired: true }; } catch (_) {}\n\nconst firstBrace = cleaned.indexOf('{');\nif (firstBrace >= 0) {\n  let depth = 0, inStr = false, esc = false, lastValidEnd = -1;\n  for (let i = firstBrace; i < cleaned.length; i++) {\n    const c = cleaned[i];\n    if (esc) { esc = false; continue; }\n    if (c === '\\\\' && inStr) { esc = true; continue; }\n    if (c === '\"') { inStr = !inStr; continue; }\n    if (inStr) continue;\n    if (c === '{') depth++;\n    else if (c === '}') { depth--; if (depth === 0) { lastValidEnd = i; break; } }\n  }\n  if (lastValidEnd > 0) {\n    const slice = cleaned.slice(firstBrace, lastValidEnd + 1);\n    try { return { output: JSON.parse(slice), _recovered: true }; } catch (_) {}\n    try { return { output: JSON.parse(repair(slice)), _recovered: true, _repaired: true }; } catch (_) {}\n  }\n}\n\nconst finish = item?.finishReason ?? item?.candidates?.[0]?.finishReason ?? 'unknown';\nthrow new Error('Failed to parse Gemini JSON (finishReason=' + finish + '). If MAX_TOKENS, increase maxOutputTokens. Raw length: ' + raw.length + '. First 400 chars: ' + raw.slice(0, 400));"
      }
    },
    {
      "id": "7e8ed4ea-b264-44dc-b6c5-6c261e9e2dc6",
