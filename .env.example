# Optional — only needed if you want to use the helper scripts in tools/
# against your running n8n instance. The workflow itself stores its
# credentials inside n8n; nothing in here is read at workflow runtime.

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=paste-n8n-personal-api-key-here

# After importing the workflow, find the ID in the URL bar
# (e.g. http://localhost:5678/workflow/AbCdEfGh123) and paste it below.
# tools/sync_workflow.py auto-resolves this when run on the OCR JSON.
N8N_OCR_INVOICE_WORKFLOW_ID=
