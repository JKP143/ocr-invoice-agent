        420,
        400
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "id": "r1a",
                    "leftValue": "={{ $json.message.photo }}",
                    "rightValue": "",
