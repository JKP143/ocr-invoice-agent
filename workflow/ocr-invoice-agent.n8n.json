        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const safeGet = (name) => { try { return $(name).first()?.json; } catch (e) { return null; } };\n\nconst v = safeGet('AI Agent - Vision')?.output;\nconst t = safeGet('AI Agent - Text')?.output;\nconst data = v || t || {};\nconst drive = safeGet('Google Drive - Upload') || {};\nconst sbRow = safeGet('Supabase - Insert Invoice') || {};\n\nconst na = (x) => (x === null || x === undefined || x === '') ? 'N/A' : x;\nconst money = (x) => (x === null || x === undefined || x === '') ? 'N/A' : Number(x).toFixed(2);\n\nconst discountsArr = Array.isArray(data.discounts) ? data.discounts : [];\nconst discountsStr = discountsArr.length === 0\n  ? 'None'\n  : discountsArr.map(d => `${d.label || 'Discount'} (-${Math.abs(Number(d.amount) || 0).toFixed(2)})`).join(', ');\n\nconst currency = data.currency ? ' ' + data.currency : '';\nconst driveName = drive.name ? ' as `' + drive.name + '`' : '';\nconst driveUrl = drive.webViewLink || '';\n\nconst lines = [];\nlines.push('*Thanks for submitting your invoice!*');\nlines.push('');\nlines.push('*Here are the key details I extracted:*');\nlines.push(`- Merchant/Store: ${na(data.vendor_name)}`);\nlines.push(`- Invoice No.: ${na(data.invoice_number)}`);\nlines.push(`- Invoice Date: ${na(data.invoice_datetime_pretty || data.invoice_date)}`);\nlines.push(`- Total Amount: ${money(data.total)}${currency}`);\nlines.push(`- Payment Method: ${na(data.payment_method)}`);\nlines.push('');\nlines.push('*Notes summary:*');\nlines.push(`- Subtotal: ${money(data.subtotal)}`);\nlines.push(`- Discounts applied: ${discountsStr}`);\nlines.push(`- Final total charged: ${money(data.total)}`);\nlines.push(`- Pax: ${na(data.pax)} | Seniors: ${na(data.seniors_count)} | PWD: ${na(data.pwd_count)}`);\nlines.push(`- Cashier: ${na(data.cashier)}`);\nlines.push('');\nlines.push(`The original invoice has been saved to Google Drive${driveName}.`);\nlines.push('');\nif (driveUrl) lines.push(`Original invoice image: [Original File](${driveUrl})`);\nif (sbRow.id) lines.push(`Invoice DB row ID: \\`${sbRow.id}\\``);\n\nreturn [{ json: { message_text: lines.join('\\n'), invoice_id: sbRow.id || null } }];"
      }
    },
